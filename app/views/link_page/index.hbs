<h2>Links</h2>

<ul>
    {{#each links}}
        <li>
            <a href="{{url}}" target="_blank">{{this.title}} - {{this.url}}</a>
            <form action="/link-page/delete" method="POST" style="display:inline;">
                <input type="hidden" name="id" value="{{id}}" />
                <button type="submit">Delete</button>
            </form>
        </li>
    {{/each}}
</ul>

<form method="POST" action="/link-page/create">
    <label for="title">
        <input type="text" name="title" placeholder="Title" />
    </label>
    <label for="url">
        <input type="url" name="url" size="150" placeholder="Enter the url" required />
    </label>
    <button type="submit">Add</button>
</form>

<button id="pasteBtn">Add from clipboard</button>
<script>
    document.getElementById('pasteBtn').addEventListener('click', async () => {
        try {
            const text = await navigator.clipboard.readText();
            fetch('/link-page/create', {
                headers: {
                    "content-type": "application/x-www-form-urlencoded",
                },
                method: "POST",
                body: `title=&url=${text}`,
            }).then(() => {
                window.location.reload()
            })
        } catch (err) {
            alert('Not able to read clipboard, please check the browser permission');
            console.error(err);
        }
    });
</script>