<style>
    body {
        text-align: center;
    }
</style>

<body>
<h1>Telegram Code Input</h1>
<br />
<form action="/tg/code" method="POST">
    <label for="code">Code：</label>
    <input type="number" id="code" name="code" size="80" required>
    <button type="submit">Submit</button>
</form>
<br />
{{#if error}}
    <span class="message error">{{error}}</span>
{{/if}}
<br />
</body>
