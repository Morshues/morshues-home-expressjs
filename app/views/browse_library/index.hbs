<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Library</title>
    <style>
        body { font-family: Arial, sans-serif; text-align: center; }
        .item-list { list-style: none; padding: 0; }
        .folder, .video-item { cursor: pointer; padding: 5px 10px; border-radius: 5px; display: flex; align-items: center; gap: 10px; }
        .folder { font-weight: bold; color: #007bff; flex-wrap: wrap; }
        .folder > .label::before { content: "📁"; }
        .thumbnail { width: 120px; height: 70px; object-fit: cover; border-radius: 5px; }
        .nested { display: none; margin-left: 20px; width: 100%; }
        .expanded > .nested { display: block; border-left: 1px lightgray solid; }
        .video-item a { display: flex; align-items: center; gap: 10px; }
        .delete-btn { border: none; background: none; cursor: pointer; font-size: 1em; }
        .manage-panel { display: inline-flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: center; margin-bottom: 16px; padding: 10px; border: 1px solid lightgray; border-radius: 5px; }
        #upload-progress { width: 200px; }
    </style>
</head>
<body>
<h1>Library</h1>

{{#if user}}
<div class="manage-panel">
    <label>目的資料夾 <select id="target-dir"></select></label>
    <button type="button" id="create-folder-btn">新增資料夾</button>
    <input type="file" id="upload-input" multiple accept="video/*,.mkv,.avi,.mov">
    <button type="button" id="upload-btn">上傳</button>
    <progress id="upload-progress" value="0" max="100" hidden></progress>
    <span id="upload-status"></span>
</div>
{{else}}
<p><a href="/auth/login">登入以管理影片</a></p>
{{/if}}

<ul id="library-container" class="item-list"></ul>

<script>
    const isLoggedIn = {{#if user}}true{{else}}false{{/if}};

    function encodePath(relPath) {
        return relPath.split('/').map(encodeURIComponent).join('/');
    }

    async function fetchLibrary() {
        try {
            const response = await fetch('/library/list');
            const data = await response.json();
            const container = document.getElementById('library-container');
            container.replaceChildren();
            renderLibrary(data, container);
            if (isLoggedIn) renderFolderOptions(data);
        } catch (error) {
            console.error('Error loading library:', error);
        }
    }

    function createDeleteButton(title, onConfirm) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'delete-btn';
        btn.textContent = '🗑';
        btn.title = title;
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (confirm(`${title}？`)) onConfirm();
        });
        return btn;
    }

    function renderLibrary(items, container) {
        items.forEach(item => {
            const li = document.createElement('li');

            if (item.type === 'folder') {
                li.className = 'folder';
                const label = document.createElement('span');
                label.className = 'label';
                label.textContent = item.name;
                li.appendChild(label);
                if (isLoggedIn) {
                    li.appendChild(createDeleteButton(`刪除資料夾 ${item.relPath}`,
                        () => manageRequest('DELETE', `/library/folder/${encodePath(item.relPath)}`)));
                }
                const nestedUl = document.createElement('ul');
                nestedUl.className = 'nested';
                li.appendChild(nestedUl);

                li.addEventListener('click', (e) => {
                    e.stopPropagation();
                    li.classList.toggle('expanded');
                    if (!nestedUl.hasChildNodes()) {
                        renderLibrary(item.children, nestedUl);
                    }
                });
            } else if (item.type === 'video') {
                li.className = 'video-item';
                const a = document.createElement('a');
                a.href = `/library/v/${encodePath(item.relPath)}`;
                const img = document.createElement('img');
                img.className = 'thumbnail';
                img.src = `/library/thumbnails/${encodePath(item.relPath)}`;
                img.alt = 'Thumbnail';
                img.loading = 'lazy';
                a.append(img, item.name);
                li.appendChild(a);
                if (isLoggedIn) {
                    li.appendChild(createDeleteButton(`刪除影片 ${item.relPath}`,
                        () => manageRequest('DELETE', `/library/v/${encodePath(item.relPath)}`)));
                }
            }

            container.appendChild(li);
        });
    }

    function renderFolderOptions(items) {
        const select = document.getElementById('target-dir');
        const selected = select.value;
        select.replaceChildren(new Option('/', ''));
        const walk = (list) => list.forEach(item => {
            if (item.type !== 'folder') return;
            select.appendChild(new Option(`/${item.relPath}`, item.relPath));
            walk(item.children);
        });
        walk(items);
        if ([...select.options].some(o => o.value === selected)) select.value = selected;
    }

    function handleUnauthorized() {
        alert('登入已失效，請重新登入');
        location.href = '/auth/login';
    }

    async function manageRequest(method, url, body) {
        const response = await fetch(url, {
            method,
            headers: body ? { 'Content-Type': 'application/json' } : {},
            body: body ? JSON.stringify(body) : undefined,
        });
        if (response.status === 401) return handleUnauthorized();
        if (!response.ok) {
            const data = await response.json().catch(() => ({}));
            alert(data.error || `操作失敗 (${response.status})`);
            return;
        }
        fetchLibrary();
    }

    function uploadFiles() {
        const input = document.getElementById('upload-input');
        const progress = document.getElementById('upload-progress');
        const status = document.getElementById('upload-status');
        const uploadBtn = document.getElementById('upload-btn');
        if (input.files.length === 0) return alert('請選擇檔案');

        const dir = document.getElementById('target-dir').value;
        const formData = new FormData();
        [...input.files].forEach(file => formData.append('files', file));

        const xhr = new XMLHttpRequest();
        xhr.open('POST', `/library/upload?dir=${encodeURIComponent(dir)}`);
        xhr.upload.onprogress = (e) => {
            if (e.lengthComputable) progress.value = Math.round(e.loaded / e.total * 100);
        };
        xhr.onloadend = () => {
            uploadBtn.disabled = false;
            progress.hidden = true;
            if (xhr.status === 401) return handleUnauthorized();
            let data = {};
            try { data = JSON.parse(xhr.responseText); } catch (e) {}
            if (xhr.status >= 200 && xhr.status < 300) {
                status.textContent = `已上傳 ${data.uploaded.length} 個檔案`;
                input.value = '';
                fetchLibrary();
            } else {
                status.textContent = '';
                alert(data.error || `上傳失敗 (${xhr.status})`);
            }
        };

        uploadBtn.disabled = true;
        progress.value = 0;
        progress.hidden = false;
        status.textContent = '上傳中…';
        xhr.send(formData);
    }

    if (isLoggedIn) {
        document.getElementById('upload-btn').addEventListener('click', uploadFiles);
        document.getElementById('create-folder-btn').addEventListener('click', () => {
            const name = prompt('資料夾名稱');
            if (!name) return;
            const dir = document.getElementById('target-dir').value;
            manageRequest('POST', '/library/folder', { dir, name });
        });
    }

    fetchLibrary();
</script>
</body>
</html>
